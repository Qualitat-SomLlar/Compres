// ===============================================================
// Som Llar - Firestore Security Rules
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers
    function isAuthenticated() { return request.auth != null; }
    function userDocExists() { return exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function getUserData() { return userDocExists() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data : {}; }
    function hasRole(role) { 
      return isAuthenticated() && (
        (userDocExists() && getUserData().role == role) ||
        (role == 'superadmin' && userDocExists() && getUserData().role == 'admin')
      ); 
    }
    function isSuperAdminEmail() {
      return isAuthenticated() && (
        request.auth.token.email in [
          'secretaria@somllar.cat',
          'secretariadq@somllar.cat',
          'lito@somllar.cat',
          'admin@somllar.cat',
          'secretariadq@prohabitatge.org'
        ] || 
        request.auth.token.email.matches('admin.*') ||
        request.auth.token.email.matches('secretaria.*')
      );
    }
    function isSuperAdmin() { 
      return isSuperAdminEmail() || 
             hasRole('superadmin') || 
             (userDocExists() && getUserData().hierarchyLevel == 99); 
    }
    function isAdmin() { 
      return isSuperAdmin() || 
             hasRole('admin_compres') || 
             hasRole('finances') || 
             hasRole('gerencia') ||
             hasRole('admin') ||
             (userDocExists() && getUserData().hierarchyLevel in [4, 5, 6, 99]) ||
             (isAuthenticated() && request.auth.token.email in ['finances@somllar.cat', 'compres@somllar.cat', 'administracio@somllar.cat']); 
    }

    match /{allPaths=**} {
      allow read, write: if isSuperAdmin();
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isAdmin() || request.auth.uid == userId);
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (request.auth.uid == userId && request.resource.data.role == resource.data.role && request.resource.data.active == resource.data.active)
      );
      allow delete: if isAuthenticated() && (isAdmin() || isSuperAdmin());
    }

    // Purchase Requests
    match /purchaseRequests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isAdmin() ||
        hasRole('coordinacio') || 
        hasRole('direccio_area') || 
        hasRole('comptabilitat') ||
        request.auth.uid == resource.data.createdByUserId
      );

      // Subcol·leccions d'adjunts i pressupostos comparatius
      match /attachments/{attachmentId} {
        allow read, write: if isAuthenticated();
      }
      match /quotes/{quoteId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Documents i pressupostos a nivell global
    match /attachments/{attachmentId} {
      allow read, write: if isAuthenticated();
    }
    match /quotes/{quoteId} {
      allow read, write: if isAuthenticated();
    }

    // Suppliers
    match /suppliers/{supplierId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Workers
    match /workers/{workerId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Centers, Projects, Analytic Codes, Areas, Hierarchy Levels
    match /centers/{id} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /projects/{id} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /analyticCodes/{id} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /areas/{id} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /hierarchyLevels/{id} { allow read: if isAuthenticated(); allow write: if isAdmin(); }

    // Notification Settings
    match /notificationSettings/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    // Audit Logs
    match /auditLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
