// ===============================================================
// Som Llar - Firestore Security Rules
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers
    function isAuthenticated() { return request.auth != null; }
    function getUserData() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasRole(role) { return isAuthenticated() && getUserData().role == role; }

    // Purchase Requests
    match /purchaseRequests/{requestId} {
      allow read: if isAuthenticated();
      
      // Només el tècnic pot crear la seva demanda
      allow create: if isAuthenticated() && request.resource.data.technicianId == request.auth.uid;
      
      // Actualització segons flux (Coordinació, Direcció, Finances)
      allow update: if isAuthenticated() && (
        hasRole('coordinacio') || 
        hasRole('direccio_area') || 
        hasRole('finances') || 
        request.auth.uid == resource.data.technicianId
      );
    }

    // Suppliers
    match /suppliers/{supplierId} {
      allow read: if isAuthenticated();
      allow write: if hasRole('finances') || hasRole('admin_compres');
    }

    // Audit Logs
    match /auditLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated(); // Només per append
      allow update, delete: if false; // Inmutable
    }
  }
}
