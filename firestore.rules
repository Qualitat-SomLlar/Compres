// ===============================================================
// Som Llar - Firestore Security Rules
// ===============================================================
// NOTA DE RENDIMENT: Firestore limita cada petició a 1.000 expressions avaluades
// (compartides entre totes les regles que coincideixen, inclosa la regla comodí).
// Per això el perfil de l'usuari es llegeix UNA sola vegada (getUserData()) i es
// passa com a paràmetre `u` a les funcions "U", en lloc de tornar-lo a calcular
// a cada helper. Les proves a tests/firestore.rules.test.ts ho verifiquen.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers
    function isAuthenticated() { return request.auth != null; }
    function userEmail() { return request.auth.token.email.lower(); }

    // Només comptes corporatius autenticats amb Microsoft.
    // (El filtre de domini del client no és una barrera de seguretat.)
    function isCorporate() {
      return isAuthenticated()
        && request.auth.token.email != null
        && userEmail().matches('.*@somllar[.]cat')
        && request.auth.token.firebase.sign_in_provider == 'microsoft.com';
    }
    function userDocExists() { return exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function getUserData() { return userDocExists() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data : {}; }

    // Camps del perfil (u = getUserData()). S'accepten també els noms de rol antics que normalitza el client.
    function lvl(u) { return u.get('hierarchyLevel', 0); }
    function rol(u) { return u.get('role', ''); }
    function area(u) { return string(u.get('areaId', '')).lower(); }

    // Rols (requereixen que l'usuari ja sigui corporatiu: es comprova a les regles)
    function isSuperAdminU(u) {
      return userEmail() in [
               'secretaria@somllar.cat',
               'secretariadq@somllar.cat',
               'lito@somllar.cat',
               'admin@somllar.cat'
             ]
          || rol(u) in ['superadmin', 'admin']
          || lvl(u) == 99;
    }
    function isAdminU(u) {
      return isSuperAdminU(u)
          || rol(u) in ['admin_compres', 'finances', 'gerencia']
          || lvl(u) in [4, 5, 6, 99]
          || userEmail() in ['finances@somllar.cat', 'compres@somllar.cat', 'administracio@somllar.cat'];
    }
    // Supervisió global del circuit (equivalent a workflowService.isWorkflowSupervisor)
    function isSupervisorU(u) {
      return isSuperAdminU(u) || lvl(u) == 6 || rol(u) in ['gerencia', 'admin_compres'];
    }
    function isCoordinatorU(u) { return lvl(u) == 2 || rol(u) in ['coordinacio', 'coordinador']; }
    function isAreaDirectorU(u) { return lvl(u) == 3 || rol(u) in ['direccio_area', 'direccio', 'responsablearea']; }
    function isFinanceU(u) { return lvl(u) == 4 || rol(u) in ['finances', 'finanzas', 'administracio']; }
    function isHighLevelU(u) { return lvl(u) >= 4; }
    function isAccountingU(u) { return rol(u) == 'comptabilitat'; }

    // Versions d'ús directe (una sola lectura del perfil per crida)
    function isSuperAdmin() { return isCorporate() && isSuperAdminU(getUserData()); }
    function isAdmin() { return isCorporate() && isAdminU(getUserData()); }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Utilitats sobre una sol·licitud de compra
    function isRequester(req) {
      return request.auth.uid == req.get('createdByUserId', '') ||
             request.auth.uid == req.get('requestingTechnicianId', '');
    }
    function sameArea(u, req) {
      return string(req.get('areaId', 'social')).lower() == area(u);
    }

    // Qui pot actuar sobre la fase actual de l'expedient
    function canActOnStep(u, req) {
      let s = req.status;
      return (s in ['esborrany', 'retornada'] && isRequester(req))
        || (s == 'pendent_coordinacio' && isCoordinatorU(u) && sameArea(u, req))
        || (s == 'pendent_direccio' && isAreaDirectorU(u) && sameArea(u, req))
        || (s in ['pendent_finances', 'aprovada'] && isFinanceU(u))
        || (s == 'comanda_emesa' && (isRequester(req) || isHighLevelU(u)))
        || (s == 'rebuda' && (isHighLevelU(u) || isFinanceU(u) || isAccountingU(u)));
    }

    // Transicions d'estat permeses (workflowService.getNextStatus)
    function validTransition(s, t) {
      return (s in ['esborrany', 'retornada'] && t == 'pendent_coordinacio')
        || (s == 'pendent_coordinacio' && t in ['pendent_direccio', 'retornada', 'rebutjada'])
        || (s == 'pendent_direccio' && t in ['pendent_finances', 'retornada', 'rebutjada'])
        || (s == 'pendent_finances' && t in ['aprovada', 'retornada', 'rebutjada'])
        || (s == 'aprovada' && t in ['comanda_emesa', 'retornada', 'rebutjada'])
        || (s == 'comanda_emesa' && t in ['rebuda', 'retornada', 'rebutjada'])
        || (s == 'rebuda' && t in ['tancada', 'retornada', 'rebutjada']);
    }

    // Camps que es poden tocar en qualsevol canvi d'estat
    function workflowFields() {
      return ['status', 'observations', 'updatedAt',
              'lastReturnComment', 'lastReturnedBy', 'lastReturnedRole', 'lastReturnedAt',
              'rejectionComment', 'rejectedBy', 'rejectedRole', 'rejectedAt'];
    }
    // Camps propis de cada fase
    function stepFields(s) {
      return s == 'pendent_coordinacio'
          ? ['coordinationApprovedAt', 'coordinationComment', 'coordinationApprovedBy', 'coordinationApproverRole']
        : s == 'pendent_direccio'
          ? ['areaDirectionApprovedAt', 'areaDirectionComment', 'areaDirectionApprovedBy', 'areaDirectionApproverRole']
        : s == 'pendent_finances'
          ? ['financeApprovedAt', 'financeComment', 'financeApprovedBy', 'financeApproverRole']
        : s == 'aprovada'
          ? ['supplierName', 'supplierId', 'productUrl', 'finalAmount']
        : s == 'comanda_emesa' ? ['receivedAt']
        : s == 'rebuda' ? ['closedAt']
        : [];
    }
    // Camps que no es poden fixar en crear una sol·licitud
    function approvalFields() {
      return stepFields('pendent_coordinacio')
        .concat(stepFields('pendent_direccio'))
        .concat(stepFields('pendent_finances'))
        .concat(['receivedAt', 'closedAt', 'rejectedAt', 'rejectedBy', 'lastReturnedAt', 'lastReturnedBy']);
    }

    // Pressupostos comparatius i adjudicació: el sol·licitant mentre no s'ha aprovat
    // la coordinació, qui aprova la fase actual, o la supervisió global.
    function canManageQuotesOn(u, req) {
      return isSupervisorU(u)
        || (isRequester(req) && req.status in ['esborrany', 'retornada', 'pendent_coordinacio'])
        || (req.status in ['pendent_coordinacio', 'pendent_direccio', 'pendent_finances'] && canActOnStep(u, req));
    }
    function requestOf(requestId) {
      return get(/databases/$(database)/documents/purchaseRequests/$(requestId)).data;
    }

    // Actualització d'una sol·licitud (u = getUserData(), llegit una sola vegada)
    function canUpdateRequest(u) {
      return isSupervisorU(u)
        // Comptadors de documents i pressupostos
        || onlyChanges(['attachmentsCount', 'quotesCount', 'updatedAt'])
        // Adjudicació / retirada d'un pressupost
        || (onlyChanges(['supplierId', 'supplierName', 'finalAmount', 'quotesCount', 'updatedAt'])
            && canManageQuotesOn(u, resource.data))
        // Avanç, retorn o rebuig dins del circuit d'aprovació
        || (validTransition(resource.data.status, request.resource.data.status)
            && canActOnStep(u, resource.data)
            && onlyChanges(workflowFields().concat(stepFields(resource.data.status))));
    }

    match /{allPaths=**} {
      allow read, write: if isSuperAdmin();
    }

    // User Profiles
    // Camps que l'usuari NO pot modificar al seu propi perfil
    function selfEditsProtected() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role', 'hierarchyLevel', 'active', 'email', 'areaId', 'areaName']);
    }
    // Pre-registre fet per un administrador: users/{correu en minúscules}
    function preRegistered() {
      return exists(/databases/$(database)/documents/users/$(userEmail()));
    }
    function preRegData() {
      return get(/databases/$(database)/documents/users/$(userEmail())).data;
    }
    function validSelfCreate(userId) {
      return request.auth.uid == userId
        && isCorporate()
        && request.resource.data.email == userEmail()
        && (
          // Alta nova sense privilegis
          (request.resource.data.role == 'tecnic'
            && request.resource.data.hierarchyLevel == 1
            && request.resource.data.active == true)
          ||
          // Migració d'un pre-registre: ha de coincidir amb el que va fixar l'administrador
          (preRegistered()
            && request.resource.data.role == preRegData().role
            && request.resource.data.hierarchyLevel == preRegData().hierarchyLevel
            && request.resource.data.active == preRegData().get('active', true)
            && request.resource.data.get('areaId', '') == preRegData().get('areaId', ''))
        );
    }
    match /users/{userId} {
      allow read: if isCorporate();
      allow create: if isAdmin() || validSelfCreate(userId);
      allow update: if isAdmin() ||
        (request.auth.uid == userId && isCorporate() && !selfEditsProtected());
      // L'usuari pot esborrar el seu propi pre-registre (ID = correu) un cop migrat
      allow delete: if isAdmin() || (isCorporate() && userId == userEmail());
    }

    // Purchase Requests
    match /purchaseRequests/{requestId} {
      allow read: if isCorporate();

      // Una sol·licitud neix com a esborrany o pendent de coordinació, a nom de qui la crea
      allow create: if isCorporate()
        && request.resource.data.createdByUserId == request.auth.uid
        && request.resource.data.status in ['esborrany', 'pendent_coordinacio']
        && !request.resource.data.keys().hasAny(approvalFields());

      allow update: if isCorporate() && canUpdateRequest(getUserData());

      // Subcol·leccions d'adjunts i pressupostos (no les fa servir l'aplicació)
      match /attachments/{attachmentId} {
        allow read: if isCorporate();
        allow write: if isCorporate() && isSupervisorU(getUserData());
      }
      match /quotes/{quoteId} {
        allow read: if isCorporate();
        allow write: if isCorporate() && isSupervisorU(getUserData());
      }
    }

    // Documents i pressupostos a nivell global
    match /attachments/{attachmentId} {
      allow read: if isCorporate();
      allow create: if isCorporate() && request.resource.data.uploadedByUserId == request.auth.uid;
      allow update, delete: if isAdmin() || (isCorporate() && request.auth.uid == resource.data.uploadedByUserId);
    }
    match /quotes/{quoteId} {
      allow read: if isCorporate();
      allow create: if isCorporate()
        && request.resource.data.isSelected == false
        && canManageQuotesOn(getUserData(), requestOf(request.resource.data.requestId));
      // Fora de la supervisió global, només es pot marcar/desmarcar l'adjudicació
      allow update: if isCorporate()
        && request.resource.data.requestId == resource.data.requestId
        && canQuoteUpdate(getUserData());
      allow delete: if isCorporate()
        && canManageQuotesOn(getUserData(), requestOf(resource.data.requestId));
    }
    function canQuoteUpdate(u) {
      return canManageQuotesOn(u, requestOf(resource.data.requestId))
        && (isSupervisorU(u) || onlyChanges(['isSelected']));
    }

    // Suppliers
    match /suppliers/{supplierId} {
      allow read: if isCorporate();
      allow write: if isAdmin();
    }

    // Workers
    match /workers/{workerId} {
      allow read: if isCorporate();
      allow write: if isAdmin();
    }

    // Centers, Projects, Analytic Codes, Areas, Hierarchy Levels
    match /centers/{id} { allow read: if isCorporate(); allow write: if isAdmin(); }
    match /projects/{id} { allow read: if isCorporate(); allow write: if isAdmin(); }
    match /analyticCodes/{id} { allow read: if isCorporate(); allow write: if isAdmin(); }
    match /areas/{id} { allow read: if isCorporate(); allow write: if isAdmin(); }
    match /hierarchyLevels/{id} { allow read: if isCorporate(); allow write: if isAdmin(); }

    // Notification Settings
    match /notificationSettings/{id} {
      allow read: if isCorporate();
      allow write: if isAdmin();
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if isCorporate() && request.auth.uid == resource.data.userId;
      allow create: if isCorporate();
      allow update: if isCorporate() && request.auth.uid == resource.data.userId;
    }

    // Activity Logs & Audit Logs
    match /activityLogs/{logId} {
      // Els administradors ho veuen tot; la resta, l'historial d'un expedient concret
      allow read: if isAdmin() || (isCorporate() && resource.data.requestId is string);
      allow create: if isCorporate() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSuperAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isCorporate();
      allow update, delete: if false;
    }
  }
}
